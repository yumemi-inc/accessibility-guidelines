{
  "name": "accessibility-guidelines",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:eslint": "eslint .",
    "fix:eslint": "eslint . --fix",
    "lint:prettier": "prettier --check .",
    "fix:prettier": "prettier --write .",
    "lint:tsc": "tsc --noEmit",
    "lint:textlint": "textlint \"src/**/*.{md,mdx}\"",
    "fix:textlint": "textlint --fix \"src/**/*.{md,mdx}\"",
    "lint:cspell": "cspell --config cspell.json \"**/*.{ts,tsx,js,jsx,md,mdx,json}\"",
    "fix:cspell": "pnpm run lint:cspell",
    "lint": "concurrently pnpm:lint:*",
    "fix": "concurrently pnpm:fix:*"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@astrojs/starlight": "0.37.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@fontsource/noto-sans-jp": "5.2.8",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "astro": "7.1.0",
    "dedent": "1.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@cspell/dict-css": "4.0.18",
    "@cspell/dict-en-common-misspellings": "2.1.8",
    "@cspell/dict-fullstack": "3.2.7",
    "@cspell/dict-html": "4.0.13",
    "@cspell/dict-npm": "5.2.25",
    "@cspell/dict-software-terms": "5.1.15",
    "@eslint/js": "9.39.1",
    "concurrently": "9.2.1",
    "cspell": "9.4.0",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-astro": "1.5.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-perfectionist": "4.15.1",
    "globals": "16.5.0",
    "prettier": "3.7.4",
    "prettier-plugin-astro": "0.14.1",
    "textlint": "15.5.0",
    "textlint-plugin-mdx": "1.0.2",
    "textlint-rule-preset-ja-technical-writing": "12.0.2",
    "textlint-rule-preset-jtf-style": "3.0.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
